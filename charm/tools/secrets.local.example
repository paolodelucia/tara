# Copy this file to secrets.local (git-ignored) and fill in your own relay.
# build.sh appends it to the firmware config. Without it, replies stay text-only.
# Never commit secrets.local: the token is compiled into the firmware.
CONFIG_MUSE_TTS_RELAY_URL="https://YOUR-RELAY-URL.run.app/tts"
CONFIG_MUSE_TTS_RELAY_TOKEN="a-long-random-string-you-also-give-the-relay"
